# Copy to .env.local and fill in what you use. Everything is optional: the app runs on the
# `claude` CLI (installed and signed in) with none of these set.

# Steer live (the lab that writes an explanation you steer as you read) runs on OpenRouter.
# Without a key, Steer live is hidden. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Where your courses live. Default: a folder named `learning` beside this app's folder.
# Set the same path in your shell profile so /teach finds it from any terminal.
# LEARNING_DIR=

# Watch (a narrated video about a highlight) needs Kokoro text-to-speech, plus `uv` and `ffmpeg` on PATH.
# Default: this app's kokoro/ folder (see kokoro/README.md for its model files). Without them, Watch is hidden.
# KOKORO_DIR=

# Where the teach skill lives, for the control room's Skill tab. Default: ~/.claude/skills/teach.
# SKILL_DIR=

# tldraw license key, for the lesson canvas outside local development. https://tldraw.dev
# NEXT_PUBLIC_TLDRAW_LICENSE_KEY=
